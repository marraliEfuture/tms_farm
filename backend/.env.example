# Copia questo file in .env e compila i valori. Il file .env NON va su GitHub.

# Porta del backend
PORT=8080
# Segreto per firmare gli accessi dei tecnici: una stringa lunga e casuale
SECRET=cambiami-con-una-stringa-lunga-e-casuale

# Indirizzo a cui l'app manda le mail (lo stesso dove arrivano oggi le mail dei clienti)
SUPPORT_ADDRESS=support@efuture.it

# Indirizzo dove è pubblicata l'app (per il collegamento dalla console e per CORS)
APP_URL=https://marraliefuture.github.io/tms_farm/

# Accesso alla console dell'ufficio (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiami

# demo = dati di esempio e mail salvate in backend/outbox (non spedite)
# live = legge da ITSM, Halo e Office 365 e spedisce davvero via SMTP
MODE=demo

# --- Invio mail (SMTP) ------------------------------------------------------
# Il server deve permettere di inviare con mittente la casella del tecnico
# (relay autorizzato o "Send As"). Se SMTP_HOST è vuoto le mail finiscono in backend/outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Halo (API REST) --------------------------------------------------------
HALO_URL=
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=

# --- ITSM di Efuture (itsm.efuture.it) ----------------------------------------
# Indirizzo e token delle API di ITSM. Vedi src/connectors/itsm.js per cosa serve.
ITSM_API_URL=
ITSM_TOKEN=

# --- Office 365 (Microsoft Graph) -------------------------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Casella da cui leggere i contatti dei clienti
GRAPH_CONTACTS_MAILBOX=support@efuture.it
